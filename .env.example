# Python API
DATABASE_URL=sqlite+pysqlite:///./data/gunther.sqlite
# Optional: one readable folder per library, with originals kept under .gunther/.
# Originals already in data/assets and data/recordings move there once, at startup.
# The desktop app defaults to ~/Gunther. See docs/LIBRARY_FOLDERS.md.
# LIBRARY_ROOT=~/Gunther-dev
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://tauri.localhost","tauri://localhost"]
# New workspaces are empty by default. Enable only when you explicitly want the guided sample.
SEED_DEMO=false

# Managed Asset and Recording originals share this quota. Writes also preserve
# this much free filesystem capacity for SQLite, the OS, and safe finalization.
STORAGE_QUOTA_BYTES=21474836480
STORAGE_MIN_FREE_BYTES=1073741824

# Optional: enables DeepSeek extraction. Without it, Gunther uses its local parser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: enables sourced web search and realtime lecture transcription.
# The key stays in the local backend and is never sent to the desktop UI.
OPENAI_API_KEY=
OPENAI_WEB_SEARCH_MODEL=gpt-5.6
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_TRANSCRIPTION_DELAY=medium
OPENAI_TRANSCRIPTION_LANGUAGES=en,zh-cn
OPENAI_SUMMARY_MODEL=gpt-5.6

# Live STT: auto prefers the private local SenseVoice service, then OpenAI.
STT_PROVIDER=auto
SENSEVOICE_URL=http://127.0.0.1:8765
SENSEVOICE_SEGMENT_SECONDS=3.2

# Structured knowledge processing. Capture returns after preserving the original;
# the local worker resumes queued jobs when the backend starts again.
PROCESSING_WORKER_ENABLED=true

# Optional offline E5 semantic retrieval (development/server Python runtime).
# First provision the semantic extra and model locally; no automatic model download.
# Use absolute paths. Change the version whenever model weights change.
# EMBEDDING_MODEL_PATH=/absolute/path/to/multilingual-e5-small
# EMBEDDING_MODEL_VERSION=your-pinned-model-revision

# Optional Docling PDF layout parser, in a separate Python environment with
# prefetched artifacts. OCR remains handled by Gunther's local OCR adapters.
# DOCLING_PYTHON=/absolute/path/to/docling-environment/bin/python
# DOCLING_ARTIFACTS_PATH=/absolute/path/to/docling-models

# Optional frontend API target. Development uses the Vite proxy by default.
VITE_API_URL=http://127.0.0.1:8787
